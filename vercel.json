{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "devCommand": "PORT=5174 BASE_PATH=/ pnpm run dev",
      "outputDirectory": "dist"
    },
    "my-ai-assistant": {
      "root": "artifacts/my-ai-assistant",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "devCommand": "PORT=5173 BASE_PATH=/ pnpm run dev",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "my-ai-assistant"
      }
    }
  ]
}